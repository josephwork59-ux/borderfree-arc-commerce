# Copy this file to .env (frontend) and export the same values in your shell
# before running Hardhat commands from contracts-pkg/ - Hardhat 3 does not
# load .env files itself. Either `export $(cat .env | xargs)` or run with
# `node --env-file=.env`.

# --- Arc Testnet (Circle) ---
# https://docs.arc.io/arc/references/connect-to-arc
# Shared by the frontend (context/NFTContext.js) and contracts-pkg/hardhat.config.js.
NEXT_PUBLIC_TESTNET=https://rpc.testnet.arc.io

# Deployer wallet private key, used only by contracts-pkg/hardhat.config.js
# to deploy/interact with contracts on Arc Testnet. Get testnet USDC (gas)
# from https://faucet.circle.com. Never commit a real key.
NEXT_PUBLIC_PRIVATE_KEY=

# API key for verifying contracts on https://testnet.arcscan.app.
# Used only by contracts-pkg/hardhat.config.js.
NEXT_PUBLIC_ARCSCAN_API_KEY=

# --- IPFS (Filebase) ---
# Server-only S3-style credentials for the Filebase IPFS bucket used to
# upload NFT assets (pages/api/upload.js). Never prefix these with
# NEXT_PUBLIC_ - they can sign arbitrary writes to the bucket and must never
# reach the browser bundle. Get these from the Filebase console under
# Access Keys, after creating an IPFS-type bucket.
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=
FILEBASE_BUCKET=

# --- Misc ---
BASE_URL=http://localhost:3000
